# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/orthonova

# Optional SQLite fallback for quick local testing without MySQL running:
# DATABASE_URL=sqlite:///./orthonova.db

# API Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
APP_ENV=development
DEBUG=True
